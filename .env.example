# Chave secreta do Flask para assinatura de cookies e sessões (obrigatório para segurança em produção)
SECRET_KEY=sua_chave_secreta_longa_e_aleatoria_aqui

# Modo de depuração (false para produção)
FLASK_DEBUG=false

# Versão do Python para o Render utilizar no build (opcional, recomendado 3.12)
PYTHON_VERSION=3.12.0
